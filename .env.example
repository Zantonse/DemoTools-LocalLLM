# ─── Demo mode ────────────────────────────────────────────────────────────────
# "mock"  = runs fully offline with a built-in simulated Okta (no tenant needed).
# "okta"  = uses your real Okta org (see docs/OKTA_SETUP.md).
DEMO_MODE=mock

# Public URL of this app (used for the OIDC redirect URI).
APP_BASE_URL=http://localhost:3000

# ─── Agent brain: a local LLM ─────────────────────────────────────────────────
# Any OpenAI-compatible server works:
#   Ollama     http://localhost:11434/v1   (default)
#   LM Studio  http://localhost:1234/v1
LOCAL_LLM_URL=http://localhost:11434/v1
# Must support tool calling. Pick a size that fits your Mac's memory (see README).
LOCAL_LLM_MODEL=qwen3:8b
# Only if your server requires one (Ollama and LM Studio don't).
LOCAL_LLM_API_KEY=
# Low temperature makes tool use more consistent.
# LOCAL_LLM_TEMPERATURE=0.1
# LOCAL_LLM_TIMEOUT_MS=120000
# Start with "local" or "scripted" (deterministic backup). Switchable live in the top bar.
AGENT_ENGINE=local

# ─── Okta (only needed when DEMO_MODE=okta) ───────────────────────────────────
# Custom authorization server issuer, e.g. https://acme.okta.com/oauth2/aus123abc
OKTA_ISSUER=
# OIDC Web App the user signs in to.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# The AI agent's own client (token exchange + CIBA). Defaults to the web app.
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# Audience of the downstream API (the "Acme Billing"). Must match the auth server audience.
API_AUDIENCE=api://acme-billing
# How the CIBA request identifies the user: "id_token_hint" (default) or "login_hint".
CIBA_HINT=id_token_hint

# ─── Demo knobs ───────────────────────────────────────────────────────────────
# Refunds above this amount need a human approval (CIBA push).
APPROVAL_THRESHOLD=500
